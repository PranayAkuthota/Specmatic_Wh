{
    "http-request": {
        "path": "/login",
        "method": "POST",
        "headers": {
            "Content-Type": "application/json"
        },
        "body": {
            "email": "wrong@example.com",
            "password": "wrongpassword"
        }
    },
    "http-response": {
        "status": 401,
        "body": {
            "error": "Invalid email or password"
        },
        "status-text": "Unauthorized",
        "headers": {
            "Content-Type": "application/json"
        }
    }
}