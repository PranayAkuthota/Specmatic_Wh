{
    "http-request": {
        "path": "/workspaces",
        "method": "POST",
        "headers": {
            "Content-Type": "application/json",
            "Authorization": "Bearer member-token"
        },
        "body": {
            "name": "Forbidden Workspace Create Attempt",
            "description": "This request should return 403 Forbidden because it is sent by a MEMBER"
        }
    },
    "http-response": {
        "status": 403,
        "body": {
